# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Database ---
# One SQLite file. Created on first run, schema included. Nothing to sign up for.
# Use an absolute path under pm2 or in a container so it does not follow the cwd.
DB_PATH=./data/curious.db

# --- htmlcsstoimage.com ---
HCTI_USER_ID=
HCTI_API_KEY=
# set RENDERER=puppeteer to use the local fallback instead
RENDERER=hcti
PUBLIC_IMAGE_BASE=                    # only needed for RENDERER=puppeteer

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                     # the approval chat (Ashish + you)

# --- Instagram Graph API ---
IG_USER_ID=                           # Instagram Business account ID, not the handle
IG_ACCESS_TOKEN=                      # long-lived Page token
GRAPH_VERSION=v21.0

# --- Editorial ---
IG_HANDLE=@curiousventures
BRAND_RED=#D11A1A
TIMEZONE=Asia/Kolkata
DRAFT_CRON=5 21 * * *
PUBLISH_CRON=0 8 * * *
REPORT_CRON=5 8 * * *
AUTO_APPROVE=false                    # flip to true on day 30
MIN_CONFIDENCE=0.7
