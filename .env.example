# --- The model call ---
# Which transport src/llm.js uses: anthropic | gemini | openai
# The prompt, the schema and the fact gate are identical on all three.
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.4

# anthropic — paid, no free tier. Recommended for production.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# gemini — free tier at aistudio.google.com, a Google account is enough.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# openai — the /chat/completions shape, which Groq, OpenRouter, Cerebras,
# Together, Mistral and a local Ollama all speak. Point the base URL at whichever
# one you have a key for. Never commit a real key; .env is gitignored.
#   OpenRouter  https://openrouter.ai/api/v1   model e.g. meta-llama/llama-3.3-70b-instruct
#   Groq        https://api.groq.com/openai/v1 model e.g. llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# One SQLite file. Created on first run, schema included. Nothing to sign up for.
# Use an absolute path under pm2 or in a container so it does not follow the cwd.
DB_PATH=./data/curious.db

# --- htmlcsstoimage.com ---
HCTI_USER_ID=
HCTI_API_KEY=
# set RENDERER=puppeteer to use the local fallback instead
RENDERER=hcti
PUBLIC_IMAGE_BASE=                    # only needed for RENDERER=puppeteer

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                     # the approval chat (Ashish + you)

# --- Instagram Graph API ---
IG_USER_ID=                           # Instagram Business account ID, not the handle
IG_ACCESS_TOKEN=                      # long-lived Page token
GRAPH_VERSION=v21.0

# --- Editorial ---
IG_HANDLE=@curiousventures
BRAND_RED=#D11A1A
TIMEZONE=Asia/Kolkata
DRAFT_CRON=5 21 * * *
PUBLISH_CRON=0 8 * * *
REPORT_CRON=5 8 * * *
AUTO_APPROVE=false                    # flip to true on day 30
MIN_CONFIDENCE=0.7
