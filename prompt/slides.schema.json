{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CuriousDeskPost",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chosen_url",
    "chosen_title",
    "reason_for_choice",
    "day_format",
    "slides",
    "caption",
    "hashtags",
    "facts_used",
    "confidence"
  ],
  "properties": {
    "chosen_url": {
      "type": "string",
      "format": "uri",
      "description": "Must be one of the candidate URLs supplied in the input, copied exactly."
    },
    "chosen_title": { "type": "string", "maxLength": 200 },
    "reason_for_choice": {
      "type": "string",
      "maxLength": 300,
      "description": "One or two sentences. Why this story over the others, in terms of the day's format."
    },
    "day_format": {
      "type": "string",
      "enum": ["motivation", "information", "post_mortem", "useful", "know_your_vc", "recap", "meme"]
    },
    "source_domain": { "type": "string", "maxLength": 40 },

    "slides": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "description": "Exactly six, in this order: hook, context, number, insight, thesis, cta.",
      "items": { "$ref": "#/definitions/slide" }
    },

    "caption": {
      "type": "string",
      "maxLength": 1400,
      "description": "No hashtags inside the caption body. Ends with the source attribution line."
    },
    "hashtags": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^#[A-Za-z0-9_]{2,29}$" }
    },

    "facts_used": {
      "type": "array",
      "description": "Every number, company name, person name and date that appears anywhere in slides or caption.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "slide_index", "verbatim_span", "in_source"],
        "properties": {
          "value": {
            "type": "string",
            "description": "The fact exactly as it is written on the slide, e.g. '$4.2 million' or 'Zepto'."
          },
          "slide_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "0-5 for slides; 6 means the fact appears only in the caption."
          },
          "verbatim_span": {
            "type": "string",
            "minLength": 8,
            "maxLength": 300,
            "description": "A span copied character-for-character from the source article text that contains this fact. This is checked by exact substring match downstream. If no such span exists, set in_source false and leave the fact off the slide."
          },
          "in_source": { "type": "boolean" }
        }
      }
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Model's own read on whether this is publishable without a human looking at the source."
    },

    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "True if no candidate met the day's rules. When true, slides may be empty and the pipeline notifies instead of publishing."
    },
    "blocked_reason": { "type": "string", "maxLength": 300 }
  },

  "definitions": {
    "slide": {
      "type": "object",
      "required": ["layout"],
      "oneOf": [
        {
          "properties": {
            "layout": { "const": "hook" },
            "headline": { "type": "string", "minLength": 12, "maxLength": 85 },
            "standfirst": { "type": "string", "maxLength": 110 }
          },
          "required": ["layout", "headline"],
          "additionalProperties": false
        },
        {
          "properties": {
            "layout": { "const": "context" },
            "headline": { "type": "string", "maxLength": 60 },
            "body": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": { "type": "string", "maxLength": 180 }
            }
          },
          "required": ["layout", "body"],
          "additionalProperties": false
        },
        {
          "properties": {
            "layout": { "const": "number" },
            "figure": { "type": "string", "maxLength": 12 },
            "unit": { "type": "string", "maxLength": 24 },
            "label": { "type": "string", "maxLength": 120 }
          },
          "required": ["layout", "figure", "label"],
          "additionalProperties": false
        },
        {
          "properties": {
            "layout": { "const": "insight" },
            "quote": { "type": "string", "minLength": 20, "maxLength": 200 },
            "attribution": { "type": "string", "maxLength": 60 }
          },
          "required": ["layout", "quote"],
          "additionalProperties": false
        },
        {
          "properties": {
            "layout": { "const": "thesis" },
            "statement": { "type": "string", "minLength": 20, "maxLength": 190 }
          },
          "required": ["layout", "statement"],
          "additionalProperties": false
        },
        {
          "properties": {
            "layout": { "const": "cta" },
            "line": { "type": "string", "maxLength": 90 }
          },
          "required": ["layout", "line"],
          "additionalProperties": false
        }
      ]
    }
  }
}
